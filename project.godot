; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Malvinas"
config/description="Codename Malvinas — RPG survival horror por turnos, Guerra de Malvinas 1982."
config/version="0.0.1"
run/main_scene="res://scenes/ui/title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[gui]
theme/custom="res://assets/fonts/game_theme.tres"

[autoload]

Dice="*res://scripts/systems/dice.gd"
GameState="*res://scripts/autoload/game_state.gd"
Dialogue="*res://scenes/ui/dialogue.tscn"
Transition="*res://scenes/ui/transition.tscn"
NpcMenu="*res://scenes/ui/npc_menu.tscn"
Journal="*res://scenes/ui/journal.tscn"
PauseMenu="*res://scenes/ui/pause_menu.tscn"
AudioManager="*res://scripts/systems/audio_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/LPCAnimatedSprite/plugin.cfg")

