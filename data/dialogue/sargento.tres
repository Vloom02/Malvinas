[gd_resource type="Resource" script_class="DataDialogue" format=3]

[ext_resource type="Script" path="res://scripts/systems/data_dialogue.gd" id="1"]

[resource]
script = ExtResource("1")
text = "El sargento chupa un cigarrillo. «Esto está jodido, pibe. Peor que Corea.»"
options = [{
"text": "¿Hay noticias?",
"next_path": "res://data/dialogue/sargento_noticias.tres",
"set_flag": "",
"journal_entry": "Hablé con el sargento. Confirmó que estamos solos.",
"sanity_cost": 0
}, {
"text": "¿Viste algo raro en el campo?",
"next_path": "res://data/dialogue/sargento_raro.tres",
"set_flag": "",
"journal_entry": "",
"sanity_cost": 2
}, {
"text": "Tengo que seguir.",
"next_path": "",
"set_flag": "",
"journal_entry": "",
"sanity_cost": 0
}]
